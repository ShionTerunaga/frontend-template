{
  "name": "main-template",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "gh-init": "gh-issue-kit init",
    "gh-create": "gh-issue-kit create",
    "gh-send": "gh-issue-kit send",
    "changeset": "changeset",
    "build": "pnpm run build:all",
    "build:list": "node --experimental-strip-types ./scripts/print-workspace-commands.ts build",
    "build:all": "node --experimental-strip-types ./scripts/run-workspace-task.ts build all",
    "build:rna-tw": "node --experimental-strip-types ./scripts/run-workspace-task.ts build rna-tw",
    "build:rna-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build rna-ve",
    "build:rnp-tw": "node --experimental-strip-types ./scripts/run-workspace-task.ts build rnp-tw",
    "build:rnp-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build rnp-ve",
    "build:rr-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build rr-ve",
    "build:rtr-tw": "node --experimental-strip-types ./scripts/run-workspace-task.ts build rtr-tw",
    "build:rtr-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build rtr-ve",
    "build:vn-sc": "node --experimental-strip-types ./scripts/run-workspace-task.ts build vn-sc",
    "build:vn-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build vn-ve",
    "build:vr-sc": "node --experimental-strip-types ./scripts/run-workspace-task.ts build vr-sc",
    "build:vr-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build vr-ve",
    "dev": "pnpm run dev:list",
    "dev:list": "node --experimental-strip-types ./scripts/print-workspace-commands.ts dev",
    "dev:all": "turbo run dev --parallel",
    "dev:rna-tw": "pnpm --filter @apps/react-next-app-tailwind dev",
    "dev:rna-ve": "pnpm --filter @apps/react-next-app-vanilla-extract dev",
    "dev:rnp-tw": "pnpm --filter @apps/react-next-pages-tailwind dev",
    "dev:rnp-ve": "pnpm --filter @apps/react-next-pages-vanilla-extract dev",
    "dev:rr-ve": "pnpm --filter @apps/react-react-router-vanilla-extract dev",
    "dev:rtr-tw": "pnpm --filter @apps/react-tanstack-router-tailwind dev",
    "dev:rtr-ve": "pnpm --filter @apps/react-tanstack-router-vanilla-extract dev",
    "dev:vn-sc": "pnpm --filter @apps/vue-nuxt-scoped-css dev",
    "dev:vn-ve": "pnpm --filter @apps/vue-nuxt-vanilla-extract dev",
    "dev:vr-sc": "pnpm --filter @apps/vue-vue-router-scoped-css dev",
    "dev:vr-ve": "pnpm --filter @apps/vue-vue-router-vanilla-extract dev",
    "storybook": "pnpm run storybook:list",
    "storybook:list": "node --experimental-strip-types ./scripts/print-workspace-commands.ts storybook",
    "storybook:all": "turbo run storybook --parallel",
    "storybook:rna-tw": "pnpm --filter @apps/react-next-app-tailwind storybook",
    "storybook:rna-ve": "pnpm --filter @apps/react-next-app-vanilla-extract storybook",
    "storybook:rnp-tw": "pnpm --filter @apps/react-next-pages-tailwind storybook",
    "storybook:rnp-ve": "pnpm --filter @apps/react-next-pages-vanilla-extract storybook",
    "storybook:rr-ve": "pnpm --filter @apps/react-react-router-vanilla-extract storybook",
    "storybook:rtr-tw": "pnpm --filter @apps/react-tanstack-router-tailwind storybook",
    "storybook:rtr-ve": "pnpm --filter @apps/react-tanstack-router-vanilla-extract storybook",
    "storybook:vn-sc": "pnpm --filter @apps/vue-nuxt-scoped-css storybook",
    "storybook:vn-ve": "pnpm --filter @apps/vue-nuxt-vanilla-extract storybook",
    "storybook:vr-sc": "pnpm --filter @apps/vue-vue-router-scoped-css storybook",
    "storybook:vr-ve": "pnpm --filter @apps/vue-vue-router-vanilla-extract storybook",
    "build-storybook": "pnpm run build-storybook:all",
    "build-storybook:list": "node --experimental-strip-types ./scripts/print-workspace-commands.ts build-storybook",
    "build-storybook:all": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook all",
    "build-storybook:rna-tw": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook rna-tw",
    "build-storybook:rna-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook rna-ve",
    "build-storybook:rnp-tw": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook rnp-tw",
    "build-storybook:rnp-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook rnp-ve",
    "build-storybook:rr-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook rr-ve",
    "build-storybook:rtr-tw": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook rtr-tw",
    "build-storybook:rtr-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook rtr-ve",
    "build-storybook:vn-sc": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook vn-sc",
    "build-storybook:vn-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook vn-ve",
    "build-storybook:vr-sc": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook vr-sc",
    "build-storybook:vr-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts build-storybook vr-ve",
    "lint": "turbo run lint",
    "test": "pnpm run test:all",
    "test:list": "node --experimental-strip-types ./scripts/print-workspace-commands.ts test",
    "test:all": "node --experimental-strip-types ./scripts/run-workspace-task.ts test all",
    "test:rna-tw": "node --experimental-strip-types ./scripts/run-workspace-task.ts test rna-tw",
    "test:rna-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts test rna-ve",
    "test:rnp-tw": "node --experimental-strip-types ./scripts/run-workspace-task.ts test rnp-tw",
    "test:rnp-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts test rnp-ve",
    "test:rr-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts test rr-ve",
    "test:rtr-tw": "node --experimental-strip-types ./scripts/run-workspace-task.ts test rtr-tw",
    "test:rtr-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts test rtr-ve",
    "test:vn-sc": "node --experimental-strip-types ./scripts/run-workspace-task.ts test vn-sc",
    "test:vn-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts test vn-ve",
    "test:vr-sc": "node --experimental-strip-types ./scripts/run-workspace-task.ts test vr-sc",
    "test:vr-ve": "node --experimental-strip-types ./scripts/run-workspace-task.ts test vr-ve",
    "typecheck": "turbo run typecheck",
    "install:all": "pnpm install",
    "copy:template": "node --experimental-strip-types ./scripts/copy-parse/copy-template-main.ts",
    "create:env": "node --experimental-strip-types ./scripts/create-env/create-env.ts",
    "clean:workspace": "node --experimental-strip-types ./scripts/clean-workspace.ts",
    "reinstall:all": "pnpm run clean:workspace && pnpm install",
    "reset:install": "pnpm run clean:workspace && pnpm install",
    "doctor:deps": "node --experimental-strip-types ./scripts/verify-workspace-installs.ts",
    "check": "pnpm lint && pnpm test && pnpm typecheck",
    "version:packages": "changeset version",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lefthook": "^1.11.13",
    "turbo": "^2.9.14"
